{
  "appId": "ch.duartesantos.yuan-gym",
  "appName": "yuan-Gym",
  "webDir": "dist",
  "backgroundColor": "#0c0e12",
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0c0e12",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}