<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and later: the same rule as backup_rules.xml for the cloud backup, where
     the 25 MB cap applies. A device-to-device transfer has no such cap, and a phone moved to a
     new one should arrive with its photos and videos, so that section is left out: without one,
     a transfer takes everything, as before, except the pairing (yuan-gym-remote.json), which holds
     the session token for the server and stays out of both. A new phone pairs again. The gym
     reminder's places (opengym_gym_reminder.xml, #614) stay out of both too: they never leave the phone.
     The app wrote opengym-media/ and opengym-remote.json before it was yuan-Gym (up to 1.4.7);
     both spellings stay excluded, so an upgraded phone's old copies stay out of the backup too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="yuan-gym-media/" />
        <exclude domain="file" path="opengym-media/" />
        <exclude domain="file" path="yuan-gym-remote.json" />
        <exclude domain="file" path="opengym-remote.json" />
        <exclude domain="sharedpref" path="opengym_gym_reminder.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="yuan-gym-remote.json" />
        <exclude domain="file" path="opengym-remote.json" />
        <exclude domain="sharedpref" path="opengym_gym_reminder.xml" />
    </device-transfer>
</data-extraction-rules>
