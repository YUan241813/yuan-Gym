<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Draw into the camera cutout like iOS does under the notch: the WebView then reports a
             real env(safe-area-inset-top) and the sheets keep clear of it (the sat variable in index.css). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <!-- The launch theme, shown by the system before the WebView has a first frame.
         `android:background` is not a window attribute and was never drawn — what showed was the
         material default, a cream page in front of a black boot screen. The three items below are
         the ones androidx core-splashscreen actually reads: the colour (values/ and values-night/),
         the mark (the user's own icon, padded so the Android 12 circular mask cannot clip it), and
         the theme to switch to once the splash is gone. Without the last one the activity kept this
         window background for the rest of its life. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>